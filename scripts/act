#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCAL_ACT="${ROOT_DIR}/.tools/bin/act"

if [[ -x "${LOCAL_ACT}" ]]; then
  exec "${LOCAL_ACT}" -C "${ROOT_DIR}" "$@"
fi

if command -v act >/dev/null 2>&1; then
  exec act -C "${ROOT_DIR}" "$@"
fi

echo "act binary not found. Run ${ROOT_DIR}/scripts/install-act.sh first." >&2
exit 1
